---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | TipFlip" description="This page doesn't exist.">
  <div class="wrap narrow page-head notfound">
    <h1>No discount on this page</h1>
    <p class="lede">We couldn't find the page you were looking for.</p>
    <a class="btn" href="/">Go to the TipFlip home page</a>
  </div>
</Base>

<style>
  .notfound { padding-bottom: 96px; }
</style>
