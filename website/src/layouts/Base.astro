---
import Logo from '../components/Logo.astro';
import { CREATOR, LINKS, SITE_NAME, SITE_URL } from '../site';

interface Props {
  title: string;
  description: string;
  // Extra JSON-LD objects for this page. The site-wide ones are added here.
  schema?: object[];
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  schema = [],
  ogType = 'website',
  image = '/og-image.png',
  imageAlt = 'TipFlip: a phone showing "Please select a customer discount" with 20%, 30% and 40% buttons',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: CREATOR,
      url: `${SITE_URL}/`,
      logo: `${SITE_URL}/icon-512.png`,
      sameAs: [LINKS.tiktok, LINKS.appStore, LINKS.googlePlay].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    ...schema,
  ],
};

const nav = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/guides/', label: 'Guides' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1424" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a href="/" class="brand" aria-label="TipFlip home"><Logo height={30} /></a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a href="/" class="brand" aria-label="TipFlip home"><Logo height={26} /></a>
          <p class="muted">The tip screen prank app. Hand your phone to the waiter and let them pick your discount.</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            <li><a href="/#how-it-works">How it works</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/guides/">Guides</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            {LINKS.tiktok && <li><a href={LINKS.tiktok} rel="me">TikTok</a></li>}
          </ul>
        </nav>
      </div>
      <p class="wrap fine muted">© {new Date().getFullYear()} {CREATOR}. TipFlip is a parody app made for fun. Please tip your server fairly.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #2a3c80;
    --blue: #2c68f6;
    --bg: #ffffff;
    --surface: #f5f7fb;
    --border: #e3e7ef;
    --text: #14203f;
    --muted: #5f6b85;
    --primary: #2c68f6;
    --primary-hover: #1f55d6;
    --on-primary: #ffffff;
    /* Brand blue darkened just enough for small text on light gray. */
    --link: #1f5ae0;
    --success: #3fb72a;
    --logo-tip: var(--navy);
    --logo-flip: var(--blue);
    --shadow: 0 1px 2px rgba(30, 48, 82, 0.06), 0 8px 24px rgba(30, 48, 82, 0.1);
    --radius: 16px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e1424;
      --surface: #172036;
      --border: #26314c;
      --text: #f2f5fb;
      --muted: #a3adc4;
      --primary: #3d76ff;
      --primary-hover: #5a8bff;
      --link: #6b97ff;
      --logo-tip: #ffffff;
      --logo-flip: #3d76ff;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.4);
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  img, svg { display: block; max-width: 100%; height: auto; }
  a { color: var(--link); text-underline-offset: 3px; }
  a:hover { color: var(--primary-hover); }
  :focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; border-radius: 4px; }
  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 0.5em; }
  h1 { font-size: clamp(2.1rem, 5.5vw, 3.5rem); font-weight: 800; }
  h2 { font-size: clamp(1.6rem, 3.6vw, 2.3rem); font-weight: 800; }
  h3 { font-size: 1.2rem; font-weight: 700; }
  p { margin: 0 0 1em; }

  .wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  .narrow { max-width: 760px; }
  .muted { color: var(--muted); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; font-weight: 700; color: var(--link); margin-bottom: 0.75em; }

  .skip { position: absolute; left: -9999px; top: 8px; background: var(--bg); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }

  .logo-tip { fill: var(--logo-tip); }
  .logo-flip { fill: var(--logo-flip); }

  .site-header { border-bottom: 1px solid var(--border); background: var(--bg); }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; }
  .brand { display: inline-block; padding: 6px 0; }
  .site-header ul, .site-footer ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px 20px; flex-wrap: wrap; }
  .site-header nav a { color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.95rem; padding: 10px 0; display: inline-block; }
  .site-header nav a:hover { color: var(--primary); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 0 22px; border-radius: 12px;
    background: var(--primary); color: var(--on-primary); font-weight: 700; text-decoration: none;
  }
  .btn:hover { background: var(--primary-hover); color: var(--on-primary); }
  .btn.ghost { background: transparent; color: var(--primary); border: 1.5px solid var(--border); }
  .btn.ghost:hover { border-color: var(--primary); }

  .stores { display: flex; flex-wrap: wrap; gap: 12px; }
  .store {
    display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 6px 18px 6px 14px;
    border-radius: 12px; background: #000; color: #fff; text-decoration: none; line-height: 1.1;
  }
  a.store:hover { color: #fff; background: #1b1b1b; }
  .store.soon { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
  .store-text { display: flex; flex-direction: column; }
  .store-text small { font-size: 0.7rem; opacity: 0.8; }
  .store-text strong { font-size: 1.05rem; }

  .phone {
    margin: 0; width: 100%; max-width: 300px; border-radius: 40px; padding: 10px;
    background: #10151f; box-shadow: var(--shadow), 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }
  .phone img { border-radius: 31px; width: 100%; aspect-ratio: 390 / 844; object-fit: cover; background: #fff; }

  .section { padding: clamp(56px, 9vw, 104px) 0; }
  .section.alt { background: var(--surface); border-block: 1px solid var(--border); }
  .section-head { max-width: 680px; margin-bottom: 40px; }

  .prose h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); margin-top: 1.8em; }
  .prose h3 { margin-top: 1.4em; }
  .prose ul, .prose ol { padding-left: 1.3em; margin: 0 0 1em; }
  .prose li { margin-bottom: 0.4em; }
  .page-head { padding: clamp(40px, 7vw, 72px) 0 8px; }
  .lede { font-size: 1.2rem; color: var(--muted); }
  .crumbs { font-size: 0.9rem; margin-bottom: 18px; }
  .crumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--muted); }
  .crumbs a { color: var(--muted); }

  .callout { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin: 32px 0; }
  .callout h2 { margin-top: 0; }

  .site-footer { border-top: 1px solid var(--border); padding: 48px 0 32px; }
  .footer-grid { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .footer-grid > div { max-width: 360px; }
  .footer-grid p { margin-top: 12px; font-size: 0.95rem; }
  .site-footer nav a { color: var(--text); text-decoration: none; display: inline-block; padding: 8px 0; }
  .site-footer nav a:hover { color: var(--primary); }
  .fine { font-size: 0.85rem; margin-top: 24px; }
</style>
