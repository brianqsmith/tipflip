---
import Base from './Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { SITE_URL } from '../site';

interface Props {
  title: string;
  // The visible headline (the title tag can be longer).
  headline: string;
  description: string;
  published: string;
  updated?: string;
}

const { title, headline, description, published, updated = published } = Astro.props;
const url = new URL(Astro.url.pathname, SITE_URL).href;

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline,
    description,
    url,
    mainEntityOfPage: url,
    image: `${SITE_URL}/og-image.png`,
    datePublished: published,
    dateModified: updated,
    inLanguage: 'en-US',
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    about: { '@id': `${SITE_URL}/#app` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides/` },
      { '@type': 'ListItem', position: 3, name: headline, item: url },
    ],
  },
];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={title} description={description} schema={schema} ogType="article">
  <article class="wrap narrow">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/guides/">Guides</a></li>
          <li aria-current="page">{headline}</li>
        </ol>
      </nav>
      <h1>{headline}</h1>
      <p class="lede">{description}</p>
      <p class="muted meta">Updated <time datetime={updated}>{fmt(updated)}</time></p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <aside class="callout" aria-labelledby="get-app">
      <h2 id="get-app">Get TipFlip</h2>
      <p class="muted">The tip screen prank app for iPhone and Android. Hand your phone to the waiter and let them pick your discount. <a href="/#how-it-works">See how it works</a>.</p>
      <StoreButtons />
    </aside>
  </article>
</Base>

<style>
  article { padding-bottom: 72px; }
  .meta { font-size: 0.9rem; }
</style>
