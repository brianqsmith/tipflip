---
import { LINKS } from '../site';

const stores = [
  { name: 'App Store', label: 'Download on the', href: LINKS.appStore, icon: 'apple' },
  { name: 'Google Play', label: 'Get it on', href: LINKS.googlePlay, icon: 'play' },
];
---
<div class="stores">
  {stores.map((s) => {
    const Tag = s.href ? 'a' : 'span';
    return (
      <Tag
        class:list={['store', { soon: !s.href }]}
        href={s.href || undefined}
        aria-label={s.href ? `${s.label} ${s.name}` : `${s.name}: coming soon`}
      >
        {s.icon === 'apple' ? (
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8s2.3-1.3 3.1-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1.1-2.9-4.2zM13.9 5.1c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"/></svg>
        ) : (
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4 2.6v18.8c0 .4.4.6.7.4l10.6-9.4c.2-.2.2-.6 0-.8L4.7 2.2c-.3-.2-.7 0-.7.4zm12.8 8.1-2.4-2.1 3-2.7 3.9 2.2c.6.4.6 1.2 0 1.6l-.7.4-3.8.6zm-2.4 4.7 2.4-2.1 3.8.6.7.4c.6.4.6 1.2 0 1.6l-3.9 2.2-3-2.7z"/></svg>
        )}
        <span class="store-text">
          <small>{s.href ? s.label : 'Coming soon to'}</small>
          <strong>{s.name}</strong>
        </span>
      </Tag>
    );
  })}
</div>
